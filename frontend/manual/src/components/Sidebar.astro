---
import Default from "@astrojs/starlight/components/Sidebar.astro"
const builder = import.meta.env.BASE_URL.replace(/\/docs\/?$/, "/")
---
<a class="return-link" href={builder}>← Return to LUT Builder</a>
<Default><slot /></Default>
<style>
  .return-link { display: block; padding: 0.75rem 0; margin-bottom: 0.5rem; font-weight: 600; }
</style>
