{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm build:manual",
    "build:manual": "astro build --root manual",
    "dev:manual": "astro dev --root manual",
    "lint": "oxlint . && eslint .",
    "format": "oxfmt src tests scripts vite.config.ts eslint.config.js playwright.config.ts",
    "format:check": "oxfmt --check src tests scripts vite.config.ts eslint.config.js playwright.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:ui:checks": "playwright test --grep @checks",
    "check:browser": "node scripts/check-browser.mjs",
    "ui:shots": "node scripts/ui-shots.mjs",
    "test:ui:report": "playwright show-report",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "typecheck": "tsc --noEmit",
    "typecheck:strict-index": "tsc -p tsconfig.strict-index.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/roboto": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "effect": "4.1.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.43.1",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10",
    "@playwright/test": "1.65.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "astro": "^5.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
